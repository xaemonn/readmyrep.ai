# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Environments ----
.env
.venv
env/
venv/
ENV/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Data ----
# Raw sensor data is tracked so the project is reproducible.
# Everything derived from it is not.
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# ---- Models ----
models/*
!models/.gitkeep

# ---- Reports ----
# Figures are regenerated by src/visualization/visualize.py
reports/figures/*
!reports/figures/.gitkeep

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
data/raw/*.zip

